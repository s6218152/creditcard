# Yahoo 信箱設定
# 請填入您的 Yahoo 帳號與應用程式密碼
# 注意：標準的登入密碼在此無效，請至 Yahoo 帳號安全性頁面產生「應用程式密碼」 (App Password)
YAHOO_EMAIL=your_yahoo_email@yahoo.com
YAHOO_APP_PASSWORD=your_yahoo_app_password

# PDF 解密密碼
# 台灣信用卡對帳單的預設解密密碼通常為持卡人「身分證字號」（英文首字大寫，共 10 碼）
PDF_PASSWORD=A123456789
TAISHIN_PDF_PASSWORD=your_taishin_pdf_password
CBGCC_DAILY_PDF_PASSWORD=your_cbgcc_daily_pdf_password
SHANGHAI_CARD_PDF_PASSWORD=your_shanghai_card_pdf_password
TSB_CREDITCARD_PDF_PASSWORD=your_tsb_creditcard_pdf_password

# Taipei Fubon protected statement page
FUBON_ID=S123456789
FUBON_BIRTHDAY=0800101

# CTBC web banking login (local secrets only)
CTBC_ID=your_identity
CTBC_USER_ID=your_user_id
CTBC_PASSWORD=your_password

# Other banks: shared default credentials, local secrets only
BANK_ID=your_identity
BANK_USER_ID=your_user_id
BANK_PASSWORD=your_password

# Optional bank-specific overrides; only the provided fields replace defaults.
# Use SKBANK, FUBON, FIRST_BANK, ESUN, FEIB, UBOT, DBS, SHANGHAI,
# TAISHIN, CHB, CATHAY, HNCB, or SINOPAC as the prefix.
# ESUN_BANK_PASSWORD=your_esun_password
# FUBON_BANK_PASSWORD=your_fubon_password
# SINOPAC_BANK_PASSWORD=your_sinopac_password
